{
  "mode": "parquet",
  "factor_evaluation": {
    "enabled": false,
    "periods": [
      1,
      5,
      10
    ],
    "entry_offset": 1,
    "quantiles": 5,
    "min_assets": 10,
    "train_fraction": 0.7,
    "output_root": "../data/alpha_evaluation"
  },
  "expression_iteration": {
    "enabled": true,
    "seed": 42,
    "batches": 3,
    "batch_size": 5,
    "max_attempts_per_batch": 500,
    "output_root": "../data/alpha_mining",
    "search_space": {
      "fields": [
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "operators": [
        "add",
        "sub",
        "mul",
        "div",
        "Ref",
        "Delta",
        "Mean",
        "Std"
      ],
      "constants": [
        -1,
        0,
        1,
        2
      ],
      "windows": [
        1,
        3,
        5
      ],
      "max_depth": 4,
      "max_nodes": 20,
      "max_lookback": 20
    }
  },
  "parquet_import": {
    "enabled": false,
    "root": "data/local_market"
  },
  "parquet": {
    "root": "F:/Quantitative/parquet/basic_data/day_bar",
    "symbols": null,
    "markets": "SHSE,SZSE",
    "frequency": "1d",
    "start": "2026-01-01 00:00:00",
    "end": "2026-12-31 23:59:59",
    "skip_zero_volume": false,
    "skip_invalid_ohlc": false,
    "allow_missing_years": false,
    "max_inflight": 5000,
    "progress_every": 1000,
    "batch_size": 100
  },
  "alphas": [
    {
      "name": "return_1",
      "formula": "close / Ref(close, 1) - 1"
    },
    {
      "name": "momentum_5",
      "formula": "close / Ref(close, 5) - 1"
    },
    {
      "name": "ma_bias_5",
      "formula": "close / Mean(close, 5) - 1"
    },
    {
      "name": "volatility_5",
      "formula": "Std(close / Ref(close, 1) - 1, 5)"
    },
    {
      "name": "volume_ratio_5",
      "formula": "volume / Mean(volume, 5)"
    },
    {
      "name": "amplitude_1",
      "formula": "(high - low) / Ref(close, 1)"
    }
  ],
  "history_batch": {
    "enabled": true,
    "workers": 1,
    "output_root": "../data/history_batch"
  }
}
